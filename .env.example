# AcademicCheck AI — copy to .env and adjust.

# --- App ---
APP_NAME=AcademicCheck AI
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_API_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://academiccheck:academiccheck@postgres:5432/academiccheck

# --- Redis / queue ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
EMAIL_VERIFICATION_HOURS=48
PASSWORD_RESET_HOURS=2

# --- Guest / retention ---
GUEST_RETENTION_HOURS=24
GUEST_MAX_CHECKS=2
GUEST_MAX_WORDS=2000

# --- Uploads ---
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=80
MAX_EXTRACTED_CHARS=400000
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage
# S3 / R2 (optional)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=academiccheck
S3_REGION=auto

# --- AI providers (optional; heuristic analysis works without keys) ---
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_STRONG=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_STRONG=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_DAILY_TOKEN_BUDGET=2000000

# --- Email ---
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@academiccheck.ai

# --- Payments ---
BILLING_DEFAULT_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Scholarly metadata (optional) ---
CROSSREF_MAILTO=hello@academiccheck.ai
OPENALEX_EMAIL=hello@academiccheck.ai
SEMANTIC_SCHOLAR_API_KEY=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
