# AcademicCheck AI — copy to .env and adjust.

# --- App ---
APP_NAME=AcademicCheck AI
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-long-random-secret
APP_API_URL=http://localhost:8000
APP_WEB_URL=http://localhost:3000
APP_CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://academiccheck:academiccheck@postgres:5432/academiccheck
# Optional streaming replica for list/dashboard/public reads (eventually consistent).
DATABASE_READ_URL=

# --- Redis / queue ---
REDIS_URL=redis://redis:6379/0

# --- Auth ---
JWT_SECRET_KEY=change-me-jwt-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14
EMAIL_VERIFICATION_HOURS=24
PASSWORD_RESET_HOURS=2
EMAIL_RESEND_COOLDOWN_SECONDS=60
# Reject addresses whose domain has no MX/A/AAAA (requires network + dnspython). Keep true for launch.
EMAIL_VALIDATE_MX=true
# Comma-separated extra disposable domains (merged with built-in blocklist)
DISPOSABLE_EMAIL_DOMAINS=
# Password reset emails only for verified accounts (unverified get a fresh verify email)
REQUIRE_VERIFIED_FOR_PASSWORD_RESET=true

# --- Guest / retention ---
GUEST_RETENTION_HOURS=24
GUEST_MAX_CHECKS=2
GUEST_MAX_WORDS=2000

# --- Uploads ---
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=80
MAX_EXTRACTED_CHARS=400000
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=/data/storage
# S3 / R2 (optional)
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=academiccheck
S3_REGION=auto

# --- AI providers (optional; heuristic analysis works without keys) ---
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL_STRONG=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_STRONG=claude-3-5-haiku-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
AI_TIMEOUT_SECONDS=90
AI_MAX_RETRIES=2
AI_DAILY_TOKEN_BUDGET=2000000

# --- Email ---
# console | smtp | resend (Invoice App uses resend HTTP API)
EMAIL_PROVIDER=console
EMAIL_ASYNC=true
# Resend (preferred for launch — same as Invoice App)
EMAIL_API_KEY=
# RESEND_API_KEY=   # alias for EMAIL_API_KEY
# --- Local SMTP without vendor ---
# python ops/local_smtp_sink.py  → SMTP_HOST=127.0.0.1 SMTP_PORT=1025 SMTP_TLS=disabled
# Mailpit Docker → SMTP_HOST=mailpit (compose) or 127.0.0.1
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=auto
SMTP_TIMEOUT_SECONDS=15
SMTP_REQUIRE_AUTH=false
SMTP_EHLO_HOSTNAME=
EMAIL_FROM=noreply@academiccheck.ai
EMAIL_ENVELOPE_FROM=
EMAIL_REPLY_TO=
EMAIL_SMTP_PROBE_ON_STARTUP=true

# --- Payments ---
BILLING_DEFAULT_CURRENCY=USD
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=

# --- Scholarly metadata (optional) ---
CROSSREF_MAILTO=hello@academiccheck.ai
OPENALEX_EMAIL=hello@academiccheck.ai
SEMANTIC_SCHOLAR_API_KEY=

# --- Observability ---
SENTRY_DSN=
# Browser DSN (same project DSN is OK; Invoice App pattern)
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_RELEASE=academiccheck-web@1.0.0
NEXT_PUBLIC_APP_ENV=development
# Public-launch validation (ops/validate_public_launch.py)
# STAGING_URL=http://127.0.0.1:8000
# STAGING_WEB_URL=http://127.0.0.1:3000
OPS_PROBE_TOKEN=
LOG_LEVEL=INFO
# Slack or Discord incoming webhook (JSON). Optional file sink for local/ops proof.
ALERT_WEBHOOK_URL=
ALERT_SINK_FILE=ops/evidence/alerts.jsonl
# Public-launch validation (ops/validate_public_launch.py)
# STAGING_URL=http://127.0.0.1:8000
# STAGING_WEB_URL=http://127.0.0.1:3001
OPS_PROBE_TOKEN=
ALERT_THROTTLE_SECONDS=120
ALERT_5XX_WINDOW_SECONDS=60
ALERT_5XX_THRESHOLD=5
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_API_KEY=
# Secrets: platform env and/or SECRETS_FILE JSON. Document source:
# SECRET_MANAGER_URI=doppler://project/config | infisical://… | aws-secretsmanager://… | file:///path/secrets.json
SECRET_MANAGER_URI=
SECRETS_FILE=
# OpenTelemetry (optional): console | otlp | none
OTEL_TRACES_EXPORTER=
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_SDK_DISABLED=false
FIELD_ENCRYPTION_KEY=
FIELD_ENCRYPTION_KEY_PREVIOUS=
COOKIE_SECURE=false
REQUIRE_QUEUE=false
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
CLAMAV_HOST=
# Policy flip to make AV mandatory (HAL-12): CLAMAV_REQUIRED=true and a reachable CLAMAV_HOST.
CLAMAV_REQUIRED=false
WEBHOOK_TOLERANCE_SECONDS=300
BACKUP_ENCRYPTION_KEY=
BACKUP_ENCRYPTION_KEY_PREVIOUS=
SHARE_DEFAULT_HOURS=72

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
